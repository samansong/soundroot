# Production environment for SoundzRoot. setup-server.sh fills the __PLACEHOLDERS__
# and installs this as /etc/soundroot/soundroot.env (mode 640, root:soundroot). Never commit the real file.

APP_URL=https://__DOMAIN__
# The app's own address on the server: the payment-webhook worker posts here, bypassing the proxy.
INTERNAL_URL=http://127.0.0.1:3000

# Secrets: unique random values per server. Rotating URL_SIGNING_SECRET invalidates outstanding download links.
URL_SIGNING_SECRET=__URL_SIGNING_SECRET__
PAYMENT_WEBHOOK_SECRET=__PAYMENT_WEBHOOK_SECRET__

# Data lives inside the app directory (relative to /opt/soundroot).
DATABASE_PATH=data/soundroot.db
STORAGE_DIR=data/storage

# Backups (systemd timer runs daily at ~03:15 server time)
BACKUP_DIR=/var/backups/soundroot
BACKUP_KEEP_DAYS=14

NEXT_TELEMETRY_DISABLED=1
