# Caddy reverse proxy for SoundRoot. setup-server.sh replaces __DOMAIN__ and installs this as /etc/caddy/Caddyfile.
# Caddy obtains and renews the HTTPS certificate automatically once DNS points at this server.
__DOMAIN__ {
	encode zstd gzip

	# Audio uploads: masters up to 120 MB, stem ZIPs up to 500 MB.
	request_body {
		max_size 600MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy 127.0.0.1:3000 {
		# Large uploads and slow mobile connections
		transport http {
			read_timeout 10m
			write_timeout 10m
		}
	}

	log {
		output file /var/log/caddy/soundroot.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}
