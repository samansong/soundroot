# Copy to .env.local. All values below are development defaults.
APP_URL=http://localhost:3000
# HMAC secret used to sign private file URLs (rotate in production; load from a secrets manager)
URL_SIGNING_SECRET=dev-url-signing-secret-change-me
# Shared secret between the payment provider and our webhook endpoint
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-change-me
# SQLite file path (development). Production: PostgreSQL — see README.
DATABASE_PATH=data/soundroot.db
STORAGE_DIR=data/storage
